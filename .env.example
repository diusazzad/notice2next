# Notice2Next - Environment Configuration
# Optional: Backboard API Key for live Google Gemma 2 inference
# If left empty, Notice2Next runs in verified deterministic heuristic mode with full anti-hallucination checks.
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://api.backboard.io/v1
GEMMA_MODEL=google/gemma-2-9b-it

# Server Configuration
PORT=8000
HOST=0.0.0.0
